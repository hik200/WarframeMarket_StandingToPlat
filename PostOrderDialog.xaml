<Window x:Class="WarframeMarket_StandingToPlat.PostOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Post Order" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a1a" ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="📝 Post New Order" FontSize="18" FontWeight="Bold" 
                  Foreground="White" Margin="0,0,0,15" HorizontalAlignment="Center"/>
        
        <!-- Form -->
        <Border Grid.Row="1" Background="#2d2d2d" CornerRadius="8" Padding="20">
            <StackPanel>
                <TextBlock Text="{Binding ItemName}" FontSize="16" FontWeight="Bold" 
                          Foreground="White" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Quantity -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Quantity:" FontSize="14" FontWeight="Bold" 
                              Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="QuantityTextBox" Height="30" FontSize="12"
                             Background="#3d3d3d" Foreground="White" BorderBrush="#555555" Padding="8,6"/>
                    
                    <!-- Cost -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cost (Platinum):" FontSize="14" FontWeight="Bold" 
                              Foreground="White" VerticalAlignment="Center" Margin="0,10,10,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="CostTextBox" Height="30" FontSize="12"
                             Background="#3d3d3d" Foreground="White" BorderBrush="#555555" Padding="8,6" Margin="0,10,0,0"/>
                    
                    <!-- Rank -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Rank:" FontSize="14" FontWeight="Bold" 
                              Foreground="White" VerticalAlignment="Center" Margin="0,10,10,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="RankTextBox" Height="30" FontSize="12"
                             Background="#3d3d3d" Foreground="White" BorderBrush="#555555" Padding="8,6" Margin="0,10,0,0"/>
                    
                    <!-- Status -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="StatusText" 
                              FontSize="12" Foreground="#b0b0b0" Margin="0,15,0,0" TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="PostButton" Content="📝 Post Order" Width="120" Height="35"
                    Background="#4CAF50" Foreground="White" BorderThickness="0"
                    Margin="0,0,10,0" Click="PostButton_Click"/>
            <Button Content="❌ Cancel" Width="80" Height="35"
                    Background="#666666" Foreground="White" BorderThickness="0"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
