<Window x:Class="WarframeMarket_StandingToPlat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warframe Market Standing to Plat" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a1a">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="20">
            <StackPanel>
                <TextBlock Text="Warframe Market Standing to Plat" 
                          FontSize="24" FontWeight="Bold" 
                          Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Convert your syndicate standing into platinum!" 
                          FontSize="14" 
                          Foreground="#cccccc" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Panel - Controls -->
            <Border Grid.Column="0" Background="#2d2d2d" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Select Syndicate" FontSize="16" FontWeight="Bold" 
                              Foreground="White" Margin="0,0,0,15"/>
                    
                    <ComboBox x:Name="SyndicateComboBox" Height="35" FontSize="14"
                              Background="#3d3d3d" Foreground="White" BorderBrush="#555555"
                              SelectionChanged="SyndicateComboBox_SelectionChanged"/>
                    
                    <Button x:Name="FetchButton" Content="Fetch Market Data" 
                            Height="40" FontSize="14" FontWeight="Bold"
                            Background="#4CAF50" Foreground="White" BorderThickness="0"
                            Margin="0,20,0,0" Click="FetchButton_Click"
                            IsEnabled="False"/>
                    
                    <Button x:Name="ExportButton" Content="Export Results" 
                            Height="35" FontSize="12"
                            Background="#2196F3" Foreground="White" BorderThickness="0"
                            Margin="0,10,0,0" Click="ExportButton_Click"
                            IsEnabled="False"/>
                    
                    <Separator Margin="0,20,0,10" Background="#555555"/>
                    
                    <TextBlock Text="Status" FontSize="12" FontWeight="Bold" 
                              Foreground="White" Margin="0,0,0,5"/>
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" 
                              Foreground="#cccccc" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            
            <!-- Right Panel - Results -->
            <Border Grid.Column="1" Background="#2d2d2d" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Market Results" FontSize="16" FontWeight="Bold" 
                              Foreground="White" Margin="0,0,0,15"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ResultsPanel">
                            <TextBlock Text="Select a syndicate and click 'Fetch Market Data' to begin." 
                                      FontSize="14" Foreground="#cccccc" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Footer -->
        <Border Grid.Row="2" Background="#1a1a1a" Padding="10">
            <TextBlock Text="Warframe Market API Integration" FontSize="10" 
                      Foreground="#888888" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
