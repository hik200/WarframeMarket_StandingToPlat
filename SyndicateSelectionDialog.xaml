<Window x:Class="WarframeMarket_StandingToPlat.SyndicateSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Syndicate Scan" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a1a" ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="📂 Load Previous Scan" FontSize="18" FontWeight="Bold" 
                  Foreground="White" Margin="0,0,0,15" HorizontalAlignment="Center"/>
        
        <!-- Syndicate List -->
        <Border Grid.Row="1" Background="#2d2d2d" CornerRadius="8" Padding="15">
            <StackPanel>
                <TextBlock Text="Select a syndicate scan to load:" FontSize="14" FontWeight="Bold" 
                          Foreground="White" Margin="0,0,0,10"/>
                
                <ListBox x:Name="SyndicateListBox" Background="#3d3d3d" BorderBrush="#555555"
                        Foreground="White" FontSize="12" Height="200"
                        SelectionChanged="SyndicateListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Click to load this scan" FontSize="10" 
                                          Foreground="#cccccc" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="LoadButton" Content="📂 Load Selected" Width="120" Height="35"
                    Background="#4CAF50" Foreground="White" BorderThickness="0"
                    Margin="0,0,10,0" Click="LoadButton_Click" IsEnabled="False"/>
            <Button Content="❌ Cancel" Width="80" Height="35"
                    Background="#666666" Foreground="White" BorderThickness="0"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
